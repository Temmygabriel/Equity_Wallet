# Robinhood Chain testnet (Chain ID 46630). This public endpoint is verified.
# Override it locally only when required.
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Development/deployment account. Never commit a real private key.
DEPLOYER_PRIVATE_KEY=

# Required only for deploy:testnet. These are placeholders until official
# testnet contract addresses are verified; do not invent or commit values.
USDG=
SWAP_ADAPTER=
AAPL=
TSLA=
NVDA=

# Frontend test-contract configuration. Copy deployment output to
# frontend/.env.local; leave these blank until deploy:demo:testnet succeeds.
VITE_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_GRANT_ESCROW_ADDRESS=
VITE_USDG_ADDRESS=
VITE_AAPL_ADDRESS=
VITE_TSLA_ADDRESS=
VITE_NVDA_ADDRESS=
